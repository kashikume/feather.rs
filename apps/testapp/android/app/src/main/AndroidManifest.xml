<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The engine draws with Vulkan 1.0 (0x400000). -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="true"
        android:version="0x400000" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.FeatherTestApp">

        <!-- sensorLandscape: either landscape side. configChanges: the activity is never
             recreated for these; winit can't make a second event loop in the process. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="true"
            android:screenOrientation="sensorLandscape">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The Rust library GameActivity loads (libfeather_testapp.so), and whose
                 android_main it calls. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="feather_testapp" />
        </activity>
    </application>
</manifest>
